{
  "name": "cinema-dna",
  "private": true,
  "version": "1.0.0",
  "description": "CINEMA DNA \u2014 turn your Letterboxd export into an interactive, evidence-based taste atlas (local-first).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "keywords": [
    "letterboxd",
    "film",
    "data-visualization",
    "wikidata",
    "react",
    "d3"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=2",
    "import": "tsx pipeline/cli.ts import",
    "ingest": "tsx pipeline/cli.ts ingest",
    "enrich": "tsx pipeline/cli.ts enrich",
    "analyze": "tsx pipeline/cli.ts analyze",
    "refresh": "tsx pipeline/cli.ts all"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "d3": "^7.9.0",
    "fflate": "^0.8.3",
    "motion": "^14.6.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "umap-js": "^1.4.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
